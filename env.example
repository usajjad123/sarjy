# Server-only keys. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_key
# Obtain a free key at https://fdc.nal.usda.gov/api-key-signup/
# Development can use the limited USDA DEMO_KEY until this is set.
USDA_API_KEY=your_usda_key
# Optional legacy adapter. Supabase below is the preferred hosted store.
# Without either database configuration, development uses .data/sarjy-fit.db.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Project Settings → API. These are the project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Optional setup-only management token: used by scripts/supabase-admin.mjs.
# The application never reads this token. Never use NEXT_PUBLIC_ for it.
# SUPABASE_ACCESS_TOKEN=your_management_access_token
