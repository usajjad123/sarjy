# Server-only keys. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_key
# Obtain a free key at https://fdc.nal.usda.gov/api-key-signup/
# Development can use the limited USDA DEMO_KEY until this is set.
USDA_API_KEY=your_usda_key
# Required for production. Omit locally to use .data/sarjy-fit.db.
# Use your managed PostgreSQL provider's pooled connection URL.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
